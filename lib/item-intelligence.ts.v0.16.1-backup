import { bigquery, dataset, location, projectId, storage } from "./google";

type AnyObject = Record<string, any>;

function stripCodeFence(value: string) {
  let text = value.trim();
  text = text.replace(/^\s*```(?:json)?\s*/i, "");
  text = text.replace(/\s*```\s*$/i, "");
  return text.trim();
}

function extractJson(value: string) {
  const cleaned = stripCodeFence(value);

  try {
    return JSON.parse(cleaned);
  } catch {
    const first = cleaned.indexOf("{");
    const last = cleaned.lastIndexOf("}");
    if (first >= 0 && last > first) {
      return JSON.parse(cleaned.slice(first, last + 1));
    }
    throw new Error("The AI response could not be parsed as JSON.");
  }
}

function clampConfidence(value: unknown) {
  const n = Number(value);
  if (!Number.isFinite(n)) return 0;
  return Math.max(0, Math.min(1, n));
}

function cleanString(value: unknown) {
  if (value === null || value === undefined) return null;
  const s = String(value).trim();
  return s || null;
}

function cleanNumber(value: unknown) {
  if (value === null || value === undefined || value === "") return null;
  const n = Number(value);
  return Number.isFinite(n) ? n : null;
}

function cleanList(value: unknown) {
  if (!Array.isArray(value)) return [];
  return value.map(cleanString).filter(Boolean).slice(0, 10);
}

function buildIdentityText(result: AnyObject) {
  return [
    cleanString(result?.identification?.brand),
    cleanString(result?.identification?.item_name),
    cleanString(result?.identification?.model),
    cleanString(result?.identification?.variant),
  ].filter(Boolean).join(" ");
}

async function generateVisualAnalysis(uri: string, hint: string) {
  const prompt = `
You are the visual intelligence engine for SiteFace.

Analyse ONE photograph of a physical item.

Do two independent tasks:
1. IDENTIFY the item as specifically as the visible evidence supports.
2. Assess VISIBLE CONDITION only.

Rules:
- Never invent a brand, model, variant, age, specification or defect.
- If a brand/model cannot be established, use a generic item name and lower confidence.
- Do not infer hidden/internal or functional condition from appearance.
- Cosmetic wear is different from functional or structural damage.
- Mention important limitations caused by framing, blur, lighting or obscured areas.
- Condition grade must be one of: EXCELLENT, GOOD, FAIR, POOR, UNKNOWN.
- Confidence values must be numbers from 0 to 1.
- Do NOT provide a monetary valuation in this response.
- Produce a concise search query suitable for finding comparable used items.
${hint ? `The user supplied this optional hint: ${JSON.stringify(hint)}` : ""}

Return JSON only:
{
  "identification": {
    "category": "string",
    "item_name": "string",
    "brand": "string or null",
    "model": "string or null",
    "variant": "string or null",
    "confidence": 0.0,
    "identifying_features": ["string"]
  },
  "condition": {
    "grade": "GOOD",
    "confidence": 0.0,
    "summary": "string",
    "visible_wear": ["string"],
    "visible_damage": ["string"],
    "limitations": ["string"]
  },
  "valuation_context": {
    "search_query": "string",
    "attributes_to_confirm": ["string"]
  }
}
`.trim();

  const query = `
    SELECT
      ml_generate_text_llm_result AS response,
      ml_generate_text_status AS status
    FROM ML.GENERATE_TEXT(
      MODEL \`${projectId}.${dataset}.gemini_model\`,
      (
        SELECT
          @prompt AS prompt,
          OBJ.MAKE_REF(@uri) AS image
      ),
      STRUCT(
        0.1 AS temperature,
        2048 AS max_output_tokens,
        TRUE AS flatten_json_output
      )
    )
  `;

  const [rows] = await bigquery.query({
    query,
    location,
    params: { prompt, uri },
  });

  const row = (rows[0] || {}) as AnyObject;
  const status = String(row.status || "").trim();
  if (status) throw new Error(`Visual model returned status: ${status}`);

  const raw = String(row.response || "").trim();
  if (!raw) throw new Error("The visual model returned no generated text.");

  return extractJson(raw) as AnyObject;
}

async function generateMarketIntelligence(analysis: AnyObject) {
  const identity = buildIdentityText(analysis);
  const confidence = clampConfidence(analysis?.identification?.confidence);
  const condition = cleanString(analysis?.condition?.grade) || "UNKNOWN";
  const searchQuery =
    cleanString(analysis?.valuation_context?.search_query) ||
    identity ||
    cleanString(analysis?.identification?.item_name) ||
    "used item";

  if (!identity || confidence < 0.45) {
    return {
      available: false,
      reason: "Identification confidence is too low for a responsible valuation.",
      currency: "GBP",
      low: null,
      high: null,
      suggested: null,
      quick_sale: null,
      confidence: 0,
      evidence_summary: null,
      search_query: searchQuery,
    };
  }

  const prompt = `
You are the market intelligence layer for SiteFace.

Research the CURRENT UK second-hand market for this item:
Identity: ${identity}
Visible condition grade: ${condition}
Comparable search phrase: ${searchQuery}

Use Google Search grounding.

Your job is to estimate a RESPONSIBLE used-market asking-price range in GBP.
Use comparable currently advertised items when possible. Do not claim these are
completed/sold prices unless the search evidence explicitly shows sold prices.
Do not invent precise model/specification details not supplied above.

If the identity is too generic, the market is too broad, or evidence is weak,
set "available" to false instead of guessing.

Return JSON only:
{
  "available": true,
  "reason": null,
  "currency": "GBP",
  "low": 0,
  "high": 0,
  "suggested": 0,
  "quick_sale": 0,
  "confidence": 0.0,
  "evidence_summary": "brief explanation of the market evidence and uncertainty",
  "search_query": "concise marketplace search query"
}
`.trim();

  try {
    const query = `
      SELECT
        ml_generate_text_llm_result AS response,
        ml_generate_text_status AS status,
        ml_generate_text_grounding_result AS grounding
      FROM ML.GENERATE_TEXT(
        MODEL \`${projectId}.${dataset}.gemini_model\`,
        (SELECT @prompt AS prompt),
        STRUCT(
          0.1 AS temperature,
          2048 AS max_output_tokens,
          TRUE AS flatten_json_output,
          TRUE AS ground_with_google_search
        )
      )
    `;

    const [rows] = await bigquery.query({
      query,
      location,
      params: { prompt },
    });

    const row = (rows[0] || {}) as AnyObject;
    const status = String(row.status || "").trim();
    if (status) throw new Error(status);

    const raw = String(row.response || "").trim();
    if (!raw) throw new Error("No market response returned.");

    const parsed = extractJson(raw) as AnyObject;

    return {
      available: Boolean(parsed?.available),
      reason: cleanString(parsed?.reason),
      currency: cleanString(parsed?.currency) || "GBP",
      low: cleanNumber(parsed?.low),
      high: cleanNumber(parsed?.high),
      suggested: cleanNumber(parsed?.suggested),
      quick_sale: cleanNumber(parsed?.quick_sale),
      confidence: clampConfidence(parsed?.confidence),
      evidence_summary: cleanString(parsed?.evidence_summary),
      search_query: cleanString(parsed?.search_query) || searchQuery,
      grounding: cleanString(row.grounding),
    };
  } catch (error) {
    console.warn("[SiteFace] market intelligence unavailable", error);
    return {
      available: false,
      reason: "Live market intelligence is not available for this analysis yet.",
      currency: "GBP",
      low: null,
      high: null,
      suggested: null,
      quick_sale: null,
      confidence: 0,
      evidence_summary: null,
      search_query: searchQuery,
    };
  }
}

export async function analyseItemPhoto(image: File, hint = "") {
  const bytes = Buffer.from(await image.arrayBuffer());

  const bucketName = process.env.SITEFACE_BUCKET || "siteface-images-dev";
  const objectName = `item-analysis/${crypto.randomUUID()}/${image.name || "item.jpg"}`;
  const object = storage.bucket(bucketName).file(objectName);

  await object.save(bytes, {
    contentType: image.type,
    resumable: false,
    metadata: { cacheControl: "private, max-age=0" },
  });

  const uri = `gs://${bucketName}/${objectName}`;
  const parsed = await generateVisualAnalysis(uri, hint);

  const analysis = {
    identification: {
      category: cleanString(parsed?.identification?.category) || "Item",
      item_name: cleanString(parsed?.identification?.item_name) || "Unidentified item",
      brand: cleanString(parsed?.identification?.brand),
      model: cleanString(parsed?.identification?.model),
      variant: cleanString(parsed?.identification?.variant),
      confidence: clampConfidence(parsed?.identification?.confidence),
      identifying_features: cleanList(parsed?.identification?.identifying_features),
    },
    condition: {
      grade: cleanString(parsed?.condition?.grade) || "UNKNOWN",
      confidence: clampConfidence(parsed?.condition?.confidence),
      summary: cleanString(parsed?.condition?.summary) || "No condition summary returned.",
      visible_wear: cleanList(parsed?.condition?.visible_wear),
      visible_damage: cleanList(parsed?.condition?.visible_damage),
      limitations: cleanList(parsed?.condition?.limitations),
    },
    valuation_context: {
      search_query:
        cleanString(parsed?.valuation_context?.search_query) ||
        cleanString(parsed?.identification?.item_name) ||
        "used item",
      attributes_to_confirm: cleanList(parsed?.valuation_context?.attributes_to_confirm),
    },
  };

  const market = await generateMarketIntelligence(analysis);

  return {
    ...analysis,
    market,
    evidence_uri: uri,
  };
}
