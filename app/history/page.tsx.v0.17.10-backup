import AppShell from "../../components/AppShell";
import { getHistory } from "../../lib/data";
import { conditionClass, dateText, pretty } from "../../lib/ui";

export const dynamic = "force-dynamic";

export default async function HistoryPage() {
  const rows = await getHistory();

  return (
    <AppShell title="History">
      <div className="page-head">
        <div>
          <h1>Inspection history</h1>
          <p>Structured evidence persisted in BigQuery.</p>
        </div>
      </div>

      <div className="card table-card">
        <div className="table-wrap">
          <table className="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Property</th>
                <th>Asset</th>
                <th>Change</th>
                <th>Condition</th>
                <th>Finding</th>
                <th>Assessment</th>
              </tr>
            </thead>

            <tbody>
              {(rows as any[]).map((r) => (
                <tr key={r.inspection_id}>
                  <td>{dateText(r.created_at)}</td>
                  <td><strong>{r.property_id}</strong></td>
                  <td>{pretty(r.asset)}</td>
                  <td>{pretty(r.visual_change_type)}</td>
                  <td>
                    <span className={`status-chip ${conditionClass(r.current_condition)}`}>
                      {pretty(r.current_condition)}
                    </span>
                  </td>
                  <td>
                    {r.defect_detected
                      ? `${pretty(r.defect_type)} · ${pretty(r.severity)}`
                      : "None"}
                  </td>
                  <td>{pretty(r.consensus_status)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </AppShell>
  );
}
