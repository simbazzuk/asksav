import Link from "next/link";
import AppShell from "../components/AppShell";
import { getDashboard, getProperties, getRecentInspections } from "../lib/data";
import { conditionClass, dateText, pretty, propertyCondition } from "../lib/ui";

import SiteFacePurpose from "../components/SiteFacePurpose";
import HomePortfolioOverview from "../components/HomePortfolioOverview";
export const dynamic = "force-dynamic";

function pct(value: number, total: number) {
  if (!total) return 0;
  return Math.round((value / total) * 100);
}

function timeOnly(value: any) {
  try {
    const raw = value?.value ?? value;
    if (!raw) return "";
    return new Date(raw).toLocaleTimeString([], {
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return "";
  }
}

export default async function DashboardPage() {
  const [dashboard, properties, recent] = await Promise.all([
    getDashboard(),
    getProperties(),
    getRecentInspections(),
  ]);

  const d: any = dashboard;
  const propertyRows = properties as any[];
  const recentRows = recent as any[];

  const totalAssets = Number(d.tracked_assets || 0);
  const attentionAssets = Number(d.attention_assets || 0);
  const poorAssets = Number(d.poor_assets || 0);
  const goodAssets = Math.max(0, totalAssets - attentionAssets - poorAssets);

  const firstProperty = propertyRows[0];

  return (
    <AppShell title="Dashboard">
      <SiteFacePurpose />
      <HomePortfolioOverview />
      <section className="dashboard-head">
        <div className="page-head">
          <div>
            <h1>Portfolio overview</h1>
            <p>Current property condition and inspection activity.</p>
          </div>

          <div className="actions">
            <Link href="/inspection-session" className="btn">
              Start inspection
            </Link>
          </div>
        </div>
      </section>

      <section className="dashboard-kpis">
        <div className="card dashboard-kpi kpi-properties">
          <div className="kpi-icon">⌂</div>
          <div className="kpi-content">
            <div className="kpi-value">{String(d.properties || 0)}</div>
            <div className="kpi-label">Properties</div>
            <div className="kpi-note">In your monitored portfolio</div>
          </div>
        </div>

        <div className="card dashboard-kpi kpi-assets">
          <div className="kpi-icon">▤</div>
          <div className="kpi-content">
            <div className="kpi-value">{String(d.tracked_assets || 0)}</div>
            <div className="kpi-label">Assets monitored</div>
            <div className="kpi-note">Latest condition tracked</div>
          </div>
        </div>

        <div className="card dashboard-kpi kpi-findings">
          <div className="kpi-icon">!</div>
          <div className="kpi-content">
            <div className="kpi-value">{String(d.active_defects || 0)}</div>
            <div className="kpi-label">Active findings</div>
            <div className="kpi-note">Require review or monitoring</div>
          </div>
        </div>

        <div className="card dashboard-kpi kpi-review">
          <div className="kpi-icon">◇</div>
          <div className="kpi-content">
            <div className="kpi-value">{String(d.needs_review || 0)}</div>
            <div className="kpi-label">Needs review</div>
            <div className="kpi-note">Evidence not fully aligned</div>
          </div>
        </div>
      </section>

      <section className="dashboard-main-grid">
        <div className="dashboard-left">
          <div className="dashboard-section-heading">
            <div>
              <h2>Properties</h2>
              <p>Your property portfolio and current condition</p>
            </div>
            <Link href="/properties">View all</Link>
          </div>

          {firstProperty ? (
            <div className="card property-summary-card">
              <div className="property-summary-top">
                <div className="property-summary-name">
                  <div className="property-summary-icon" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M4.5 10.5 12 4l7.5 6.5V20H4.5v-9.5Z"
                        stroke="currentColor"
                        strokeWidth="1.8"
                        strokeLinejoin="round"
                      />
                      <path
                        d="M9.5 20v-5.5h5V20"
                        stroke="currentColor"
                        strokeWidth="1.8"
                        strokeLinejoin="round"
                      />
                    </svg>
                  </div>
                  <div>
                    <h3>{firstProperty.property_id}</h3>
                    <p>
                      {String(firstProperty.assets || 0)} monitored asset
                      {Number(firstProperty.assets || 0) === 1 ? "" : "s"}
                    </p>
                  </div>
                </div>

                <span
                  className={`status-chip ${conditionClass(
                    propertyCondition(firstProperty)
                  )}`}
                >
                  {pretty(propertyCondition(firstProperty))}
                </span>
              </div>

              <div className="property-summary-stats">
                <div className="property-mini-stat">
                  <small>Assets</small>
                  <strong>{String(firstProperty.assets || 0)}</strong>
                </div>

                <div className="property-mini-stat">
                  <small>Active findings</small>
                  <strong>{String(firstProperty.active_defects || 0)}</strong>
                </div>

                <div className="property-mini-stat">
                  <small>Last inspected</small>
                  <strong>{dateText(firstProperty.last_inspection)}</strong>
                </div>
              </div>

              <div className="actions">
                <Link
                  href={`/properties/${encodeURIComponent(firstProperty.property_id)}`}
                  className="btn secondary"
                >
                  View property
                </Link>

                <Link
                  href={`/inspection-session?property=${encodeURIComponent(firstProperty.property_id)}`}
                  className="btn"
                >
                  Inspect property
                </Link>
              </div>
            </div>
          ) : (
            <div className="card dashboard-empty">
              No properties yet. Start an inspection to create your first baseline.
            </div>
          )}

          <div className="card mobile-promo">
            <div className="mobile-promo-grid">
              <div className="phone-illustration" aria-hidden="true">
                <div className="phone-screen-block" />
                <div className="phone-screen-block" />
                <div className="phone-screen-camera">◉</div>
              </div>

              <div>
                <h3>Faster inspections on mobile</h3>
                <p>
                  Use SiteFace on your phone to follow the room checklist, match
                  previous photos and get instant AI-assisted analysis.
                </p>

                <div className="promo-points">
                  <span>Guided room-by-room capture</span>
                  <span>Previous photo framing reference</span>
                  <span>Automatic property history</span>
                </div>
              </div>

              <Link href="/inspection-session" className="btn">
                Open inspection
              </Link>
            </div>
          </div>

          <div className="dashboard-section-heading" style={{ marginTop: 24 }}>
            <div>
              <h2>Condition overview</h2>
              <p>Latest condition across monitored assets</p>
            </div>
          </div>

          <div className="card condition-card">
            <div className="condition-row">
              <div className="condition-label">Good</div>
              <div className="condition-bar">
                <div
                  className="condition-fill good"
                  style={{ width: `${pct(goodAssets, totalAssets)}%` }}
                />
              </div>
              <div className="condition-value">
                {goodAssets} · {pct(goodAssets, totalAssets)}%
              </div>
            </div>

            <div className="condition-row">
              <div className="condition-label">Attention</div>
              <div className="condition-bar">
                <div
                  className="condition-fill attention"
                  style={{ width: `${pct(attentionAssets, totalAssets)}%` }}
                />
              </div>
              <div className="condition-value">
                {attentionAssets} · {pct(attentionAssets, totalAssets)}%
              </div>
            </div>

            <div className="condition-row">
              <div className="condition-label">Poor</div>
              <div className="condition-bar">
                <div
                  className="condition-fill poor"
                  style={{ width: `${pct(poorAssets, totalAssets)}%` }}
                />
              </div>
              <div className="condition-value">
                {poorAssets} · {pct(poorAssets, totalAssets)}%
              </div>
            </div>
          </div>
        </div>

        <div className="dashboard-right">
          <div className="dashboard-section-heading">
            <div>
              <h2>Recent activity</h2>
              <p>Latest SiteFace inspection events</p>
            </div>
            <Link href="/history">View history</Link>
          </div>

          <div className="card activity-card">
            {recentRows.slice(0, 6).map((r) => {
              const isBad =
                r.defect_detected ||
                r.current_condition === "POOR";

              const isWarn =
                !isBad && r.current_condition === "ATTENTION";

              return (
                <div className="activity-item" key={r.inspection_id}>
                  <div
                    className={`activity-icon ${
                      isBad ? "danger" : isWarn ? "warn" : ""
                    }`}
                  >
                    {isBad ? "!" : isWarn ? "•" : "✓"}
                  </div>

                  <div>
                    <div className="activity-title">
                      {r.property_id} · {pretty(r.asset)}
                    </div>

                    <div className="activity-meta">
                      {r.defect_detected
                        ? `${pretty(r.defect_type)} · ${pretty(r.severity)}`
                        : r.visual_change_type === "BASELINE"
                          ? "Baseline captured"
                          : "No condition issue detected"}
                    </div>
                  </div>

                  <div className="activity-time">
                    {timeOnly(r.created_at)}
                  </div>
                </div>
              );
            })}

            {recentRows.length === 0 && (
              <div className="dashboard-empty">
                No recent activity yet.
              </div>
            )}
          </div>
        </div>
      </section>
    </AppShell>
  );
}
