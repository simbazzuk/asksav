import { NextResponse } from "next/server";
import { inspectCurrentPhoto } from "../../../lib/siteface";
import { updateSessionProgress } from "../../../lib/session-data";
import { createFindingFromInspection } from "../../../lib/finding-data";

export const runtime = "nodejs";

const MAX_FILE_SIZE = 10 * 1024 * 1024;
const ALLOWED_TYPES = new Set(["image/jpeg", "image/png", "image/webp"]);

export async function POST(request: Request) {
  try {
    const form = await request.formData();

    const current = form.get("current");
    const propertyId = String(form.get("propertyId") || "").trim();
    const asset = String(form.get("asset") || "").trim();

    const sessionId = String(form.get("sessionId") || "").trim();
    const roomId = String(form.get("roomId") || "").trim();
    const roomName = String(form.get("roomName") || "").trim();
    const assetId = String(form.get("assetId") || asset).trim();
    const assetName = String(form.get("assetName") || asset).trim();

    if (!(current instanceof File)) {
      return NextResponse.json(
        { error: "Current photograph is required." },
        { status: 400 }
      );
    }

    if (!propertyId || !asset) {
      return NextResponse.json(
        { error: "Property and asset are required." },
        { status: 400 }
      );
    }

    if (!ALLOWED_TYPES.has(current.type)) {
      return NextResponse.json(
        { error: "Only JPG, PNG and WebP images are supported." },
        { status: 400 }
      );
    }

    if (current.size > MAX_FILE_SIZE) {
      return NextResponse.json(
        { error: "Image must be 10 MB or smaller." },
        { status: 400 }
      );
    }

    const result = await inspectCurrentPhoto({
      current,
      propertyId,
      asset,
      sessionId,
      roomId,
      roomName,
      assetId,
      assetName,
    });

    let findingId: string | null = null;

    if (result.defect_detected) {
      findingId = await createFindingFromInspection({
        inspectionId: result.inspection_id,
        sessionId,
        propertyId,
        roomId,
        roomName,
        assetId,
        assetName,
        defectType: result.defect_type,
        severity: result.severity,
        confidence: result.confidence,
        description: result.summary,
        recommendedAction: result.recommended_action,
      });
    }

    if (sessionId) {
      await updateSessionProgress(sessionId);
    }

    return NextResponse.json({
      ...result,
      finding_id: findingId,
    });
  } catch (error) {
    console.error("[SiteFace] inspection failed", error);

    return NextResponse.json(
      {
        error:
          error instanceof Error
            ? error.message
            : "Unexpected inspection error.",
      },
      { status: 500 }
    );
  }
}
