"use client";

import Link from "next/link";
import { FormEvent, useState } from "react";

export default function ConfigurePropertyClient({
  propertyId,
  initialAssets,
}: {
  propertyId: string;
  initialAssets: any[];
}) {
  const [assets, setAssets] = useState(initialAssets);
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);

  async function add(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    setLoading(true);
    setError("");

    const form = new FormData(e.currentTarget);
    const payload = {
      roomName: String(form.get("roomName") || ""),
      assetName: String(form.get("assetName") || ""),
    };

    try {
      const response = await fetch(
        `/api/properties/${encodeURIComponent(propertyId)}/assets`,
        {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        }
      );

      const result = await response.json();
      if (!response.ok) throw new Error(result.error || "Could not add asset.");

      const reload = await fetch(
        `/api/properties/${encodeURIComponent(propertyId)}/assets`
      );
      setAssets(await reload.json());
      e.currentTarget.reset();
    } catch (e) {
      setError(e instanceof Error ? e.message : "Could not add asset.");
    } finally {
      setLoading(false);
    }
  }

  const rooms = Array.from(new Set(assets.map((a: any) => a.room_name)));

  return (
    <div className="config-grid">
      <section className="card card-pad">
        <h2 className="panel-title">Inspection structure</h2>
        <p className="muted">
          These rooms and assets define the checklist used for every inspection.
        </p>

        {rooms.map((room) => (
          <div className="config-room" key={room}>
            <h3>{room}</h3>
            <div className="config-assets">
              {assets
                .filter((a: any) => a.room_name === room)
                .map((a: any) => (
                  <div className="config-asset" key={a.asset_id}>
                    <span>✓</span>
                    {a.asset_name}
                  </div>
                ))}
            </div>
          </div>
        ))}

        {assets.length === 0 && (
          <div className="empty-state">No inspection assets configured yet.</div>
        )}
      </section>

      <aside className="card card-pad">
        <h2 className="panel-title">Add inspection item</h2>

        <form onSubmit={add}>
          <div className="field">
            <label>Room / area</label>
            <input
              name="roomName"
              required
              placeholder="e.g. Bedroom"
            />
          </div>

          <div className="field">
            <label>Asset / surface</label>
            <input
              name="assetName"
              required
              placeholder="e.g. Wall"
            />
          </div>

          <button className="btn" disabled={loading}>
            {loading ? "Adding..." : "Add item"}
          </button>
        </form>

        {error && <div className="error">{error}</div>}

        <div className="config-next">
          <Link
            className="btn secondary"
            href={`/inspection-session?property=${encodeURIComponent(propertyId)}`}
          >
            Start inspection
          </Link>
        </div>
      </aside>
    </div>
  );
}
