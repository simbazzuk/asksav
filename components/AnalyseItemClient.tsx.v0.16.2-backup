"use client";

import { ChangeEvent, FormEvent, useEffect, useMemo, useState } from "react";

type Result = {
  identification?: {
    category?: string;
    item_name?: string;
    brand?: string | null;
    model?: string | null;
    variant?: string | null;
    confidence?: number;
    identifying_features?: string[];
  };
  condition?: {
    grade?: string;
    confidence?: number;
    summary?: string;
    visible_wear?: string[];
    visible_damage?: string[];
    limitations?: string[];
  };
  valuation_context?: {
    search_query?: string;
    attributes_to_confirm?: string[];
  };
  market?: {
    available?: boolean;
    reason?: string | null;
    currency?: string;
    low?: number | null;
    high?: number | null;
    suggested?: number | null;
    quick_sale?: number | null;
    confidence?: number;
    evidence_summary?: string | null;
    search_query?: string;
  };
};

function pct(value?: number) {
  if (typeof value !== "number") return "—";
  return `${Math.round(value * 100)}%`;
}

function money(value?: number | null, currency = "GBP") {
  if (typeof value !== "number") return "—";
  try {
    return new Intl.NumberFormat("en-GB", {
      style: "currency",
      currency,
      maximumFractionDigits: 0,
    }).format(value);
  } catch {
    return `£${Math.round(value)}`;
  }
}

function marketplaceLinks(query: string) {
  const q = encodeURIComponent(query);
  return [
    { label: "eBay", href: `https://www.ebay.co.uk/sch/i.html?_nkw=${q}` },
    { label: "Google Shopping", href: `https://www.google.com/search?tbm=shop&q=${q}` },
    { label: "Gumtree", href: `https://www.gumtree.com/search?search_category=all&q=${q}` },
  ];
}

export default function AnalyseItemClient() {
  const [file, setFile] = useState<File | null>(null);
  const [preview, setPreview] = useState<string | null>(null);
  const [result, setResult] = useState<Result | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    return () => {
      if (preview) URL.revokeObjectURL(preview);
    };
  }, [preview]);

  const searchQuery =
    result?.market?.search_query ||
    result?.valuation_context?.search_query ||
    result?.identification?.item_name ||
    "used item";

  const links = useMemo(() => marketplaceLinks(searchQuery), [searchQuery]);

  function chooseFile(e: ChangeEvent<HTMLInputElement>) {
    const next = e.target.files?.[0] ?? null;
    if (preview) URL.revokeObjectURL(preview);
    setFile(next);
    setPreview(next ? URL.createObjectURL(next) : null);
    setResult(null);
    setError("");
  }

  async function analyse(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    if (!file) {
      setError("Choose a photo first.");
      return;
    }

    setLoading(true);
    setError("");
    setResult(null);

    const form = new FormData(e.currentTarget);
    form.set("image", file);

    try {
      const response = await fetch("/api/analyse-item", {
        method: "POST",
        body: form,
      });

      const payload = await response.json();
      if (!response.ok) throw new Error(payload.error || "Analysis failed.");
      setResult(payload);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Analysis failed.");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="sf15-analyse sf16-analyse">
      <section className="sf15-analyse-head">
        <div>
          <div className="sf15-kicker">VISUAL INTELLIGENCE</div>
          <h1>Analyse an item</h1>
          <p>Identify it, understand visible condition, estimate value and explore the market.</p>
        </div>
        <div className="sf15-stage-pills">
          <span className="active">Identify</span>
          <span className="active">Condition</span>
          <span className="active">Value</span>
          <span className="active">Discover</span>
        </div>
      </section>

      <div className="sf15-analyse-grid">
        <form className="card card-pad sf15-upload-card" onSubmit={analyse}>
          <div className="sf15-upload-title">
            <div>
              <small>STEP 1</small>
              <h2>Show us the item</h2>
            </div>
          </div>

          <label className={`sf15-dropzone ${preview ? "has-image" : ""}`}>
            {preview ? (
              <img src={preview} alt="Item selected for analysis" />
            ) : (
              <div>
                <strong>Take or upload a photo</strong>
                <span>Use a clear image showing as much of the item as possible.</span>
              </div>
            )}
            <input type="file" accept="image/jpeg,image/png,image/webp" capture="environment" onChange={chooseFile} />
          </label>

          <label className="sf15-field">
            <span>Anything you already know? <small>Optional</small></span>
            <input name="hint" placeholder="e.g. Logitech keyboard, office chair, bicycle..." />
          </label>

          <div className="sf15-photo-tips">
            <strong>For a better result</strong>
            <span>Show the complete item where practical.</span>
            <span>Include logos, labels or model markings.</span>
            <span>Add known details if a specification is not visible.</span>
          </div>

          <button className="btn primary sf15-analyse-button" disabled={!file || loading}>
            {loading ? "Identifying, assessing & checking market..." : "Analyse item"}
          </button>

          {error && <div className="sf15-error">{error}</div>}
        </form>

        <section className="sf15-results">
          {!result ? (
            <div className="card card-pad sf15-awaiting">
              <div className="sf15-awaiting-orb">AI</div>
              <h2>Your visual intelligence report</h2>
              <p>One image becomes four layers of useful intelligence.</p>
              <div className="sf15-awaiting-flow">
                <span>Identify</span><i>→</i><span>Condition</span><i>→</i><span>Value</span><i>→</i><span>Discover</span>
              </div>
            </div>
          ) : (
            <>
              <article className="sf15-result-card identify">
                <div className="sf15-result-label"><span>01</span> IDENTIFY</div>
                <div className="sf15-result-head">
                  <div>
                    <small>{result.identification?.category || "ITEM"}</small>
                    <h2>{result.identification?.item_name || "Item identified"}</h2>
                    <p>
                      {[result.identification?.brand, result.identification?.model, result.identification?.variant]
                        .filter(Boolean).join(" · ") || "No reliable brand/model confirmed from this image."}
                    </p>
                  </div>
                  <div className="sf15-score">
                    <strong>{pct(result.identification?.confidence)}</strong>
                    <small>confidence</small>
                  </div>
                </div>
                {!!result.identification?.identifying_features?.length && (
                  <div className="sf15-tags">
                    {result.identification.identifying_features.map((x) => <span key={x}>{x}</span>)}
                  </div>
                )}
              </article>

              <article className="sf15-result-card condition">
                <div className="sf15-result-label"><span>02</span> CONDITION</div>
                <div className="sf15-result-head">
                  <div>
                    <small>VISIBLE CONDITION</small>
                    <h2>{result.condition?.grade || "Unknown"}</h2>
                    <p>{result.condition?.summary || "No condition summary returned."}</p>
                  </div>
                  <div className="sf15-score">
                    <strong>{pct(result.condition?.confidence)}</strong>
                    <small>confidence</small>
                  </div>
                </div>

                <div className="sf15-condition-columns">
                  <div>
                    <strong>Visible wear</strong>
                    {(result.condition?.visible_wear?.length ? result.condition.visible_wear : ["None confidently identified"]).map((x) => <span key={x}>{x}</span>)}
                  </div>
                  <div>
                    <strong>Visible damage</strong>
                    {(result.condition?.visible_damage?.length ? result.condition.visible_damage : ["None confidently identified"]).map((x) => <span key={x}>{x}</span>)}
                  </div>
                </div>

                {!!result.condition?.limitations?.length && (
                  <div className="sf15-limitations">
                    <strong>What cannot be confirmed</strong>
                    {result.condition.limitations.map((x) => <span key={x}>{x}</span>)}
                  </div>
                )}
              </article>

              <article className="sf15-result-card value sf16-value">
                <div className="sf15-result-label"><span>03</span> VALUE</div>

                {result.market?.available ? (
                  <>
                    <div className="sf16-value-hero">
                      <div>
                        <small>ESTIMATED UK USED-MARKET VALUE</small>
                        <h2>
                          {money(result.market.low, result.market.currency)}
                          <span>–</span>
                          {money(result.market.high, result.market.currency)}
                        </h2>
                        <p>Current market estimate based on available web evidence and the visible condition assessment.</p>
                      </div>
                      <div className="sf15-score">
                        <strong>{pct(result.market.confidence)}</strong>
                        <small>valuation confidence</small>
                      </div>
                    </div>

                    <div className="sf16-price-grid">
                      <div>
                        <small>SUGGESTED LISTING</small>
                        <strong>{money(result.market.suggested, result.market.currency)}</strong>
                      </div>
                      <div>
                        <small>QUICK SALE</small>
                        <strong>{money(result.market.quick_sale, result.market.currency)}</strong>
                      </div>
                    </div>

                    {result.market.evidence_summary && (
                      <div className="sf16-market-evidence">
                        <small>MARKET EVIDENCE</small>
                        <p>{result.market.evidence_summary}</p>
                      </div>
                    )}
                  </>
                ) : (
                  <div className="sf16-value-unavailable">
                    <small>VALUATION NOT YET RELIABLE</small>
                    <h2>More detail needed</h2>
                    <p>{result.market?.reason || "SiteFace could not establish enough evidence for a responsible valuation."}</p>
                  </div>
                )}

                {!!result.valuation_context?.attributes_to_confirm?.length && (
                  <div className="sf15-confirm">
                    <small>Confirm these details to improve the valuation</small>
                    <div className="sf15-tags">
                      {result.valuation_context.attributes_to_confirm.map((x) => <span key={x}>{x}</span>)}
                    </div>
                  </div>
                )}
              </article>

              <article className="sf15-result-card sf16-discover-card">
                <div className="sf15-result-label"><span>04</span> DISCOVER</div>
                <div className="sf16-discover-head">
                  <div>
                    <small>SIMILAR ITEMS</small>
                    <h2>Explore the market</h2>
                    <p>Open the search on external marketplaces to inspect comparable items yourself.</p>
                  </div>
                </div>

                <div className="sf15-search-query">
                  <small>SEARCHING FOR</small>
                  <strong>{searchQuery}</strong>
                </div>

                <div className="sf16-market-links">
                  {links.map((link) => (
                    <a key={link.label} href={link.href} target="_blank" rel="noreferrer">
                      <span>{link.label}</span>
                      <strong>View similar items ↗</strong>
                    </a>
                  ))}
                </div>

                <p className="sf16-disclaimer">
                  Marketplace prices are external asking prices and can change. SiteFace does not guarantee a sale price.
                </p>
              </article>
            </>
          )}
        </section>
      </div>
    </main>
  );
}
