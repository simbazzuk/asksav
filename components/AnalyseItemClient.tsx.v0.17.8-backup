"use client";

import { ChangeEvent, FormEvent, useEffect, useMemo, useState } from "react";

type Result = {
  identification?: {
    item_name?: string;
    brand?: string | null;
    model?: string | null;
    variant?: string | null;
    confidence?: number;
    identifying_features?: string[];
  };
  verification?: {
    verified?: boolean;
    reason?: string;
  };
  condition?: {
    grade?: string;
    confidence?: number;
    summary?: string;
    visible_wear?: string[];
    visible_damage?: string[];
    limitations?: string[];
  };
  valuation_context?: {
    search_query?: string;
  };
  market?: {
    available?: boolean;
    reason?: string | null;
    currency?: string;
    low?: number | null;
    high?: number | null;
    suggested?: number | null;
    quick_sale?: number | null;
    confidence?: number;
    evidence_summary?: string | null;
    search_query?: string;
  };
};

function pct(value?: number) {
  return typeof value === "number" ? `${Math.round(value * 100)}%` : "—";
}

function money(value?: number | null, currency = "GBP") {
  if (typeof value !== "number") return "—";
  try {
    return new Intl.NumberFormat("en-GB", {
      style: "currency",
      currency,
      maximumFractionDigits: 0,
    }).format(value);
  } catch {
    return `£${Math.round(value)}`;
  }
}

function marketplaceLinks(query: string) {
  const q = encodeURIComponent(query);
  return [
    { label: "eBay UK", href: `https://www.ebay.co.uk/sch/i.html?_nkw=${q}`, mark: "e" },
    { label: "Google Shopping", href: `https://www.google.com/search?tbm=shop&q=${q}`, mark: "G" },
    { label: "Gumtree", href: `https://www.gumtree.com/search?search_category=all&q=${q}`, mark: "g" },
  ];
}

export default function AnalyseItemClient() {
  const [file, setFile] = useState<File | null>(null);
  const [preview, setPreview] = useState<string | null>(null);
  const [result, setResult] = useState<Result | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    document.documentElement.classList.add("sf177-active");
    document.body.classList.add("sf177-active");

    return () => {
      document.documentElement.classList.remove("sf177-active");
      document.body.classList.remove("sf177-active");
      if (preview) URL.revokeObjectURL(preview);
    };
  }, [preview]);

  const searchQuery =
    result?.market?.search_query ||
    result?.valuation_context?.search_query ||
    result?.identification?.item_name ||
    "used item";

  const links = useMemo(() => marketplaceLinks(searchQuery), [searchQuery]);

  function chooseFile(e: ChangeEvent<HTMLInputElement>) {
    const next = e.target.files?.[0] ?? null;
    if (preview) URL.revokeObjectURL(preview);
    setFile(next);
    setPreview(next ? URL.createObjectURL(next) : null);
    setResult(null);
    setError("");
  }

  async function analyse(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    if (!file) {
      setError("Choose a photo first.");
      return;
    }

    setLoading(true);
    setError("");
    setResult(null);

    const form = new FormData(e.currentTarget);
    form.set("image", file);

    try {
      const response = await fetch("/api/analyse-item", {
        method: "POST",
        body: form,
      });

      const payload = await response.json();
      if (!response.ok) throw new Error(payload.error || "Analysis failed.");
      setResult(payload);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Analysis failed.");
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="sf177-shell">
      <aside className="sf177-sidebar">
        <a href="/" className="sf177-brand">
          <span className="sf177-logo">SF</span>
          <span>
            <strong>SiteFace</strong>
            <small>Visual Intelligence</small>
          </span>
        </a>

        <a href="/analyse" className="sf177-side-cta">＋ Analyse an item</a>

        <nav className="sf177-side-nav">
          <a href="/"><span>⌂</span>Home</a>
          <a href="/analyse" className="active"><span>◎</span>Analyse</a>
          <a href="/history"><span>◷</span>History</a>
        </nav>

        <div className="sf177-side-card">
          <strong>See it. Know it. Value it.</strong>
          <p>Visual intelligence for the things you own and discover.</p>
        </div>

        <div className="sf177-status">● All systems ready</div>
      </aside>

      <header className="sf177-header">
        <nav>
          <a href="/">Home</a>
          <a href="/analyse" className="active">Analyse</a>
          <a href="/history">History</a>
        </nav>

        <div className="sf177-header-actions">
          <div className="sf177-mantra">◉ See it. Know it. Value it.</div>
          <div className="sf177-avatar">SP</div>
        </div>
      </header>

      <main className="sf177-main">
        <section className="sf177-hero">
          <div className="sf177-hero-copy">
            <span className="sf177-kicker">VISUAL INTELLIGENCE</span>
            <h1>See it. <span>Know it.</span> Value it.</h1>
            <p>Upload one photo and SiteFace turns it into a verified item report with condition and market insight.</p>
          </div>

          <div className="sf177-object-strip" aria-hidden="true">
            <div className="watch">⌚</div>
            <div className="chair">🪑</div>
            <div className="shoe">👟</div>
            <div className="bag">👜</div>
            <div className="headphones">🎧</div>
            <div className="laptop">💻</div>
          </div>
        </section>

        <section className="sf177-flow">
          {[
            ["🔎", "Identify", "What is it?", "blue"],
            ["🛡", "Verify", "Can we trust it?", "green"],
            ["⚙", "Condition", "What's the state?", "amber"],
            ["£", "Value", "What's it worth?", "violet"],
            ["◫", "Discover", "Find similar", "purple"],
          ].map(([icon, title, sub, tone], index) => (
            <article key={title} className={`sf177-flow-card ${tone}`}>
              <span className="sf177-flow-icon">{icon}</span>
              <div>
                <strong>{title}</strong>
                <small>{sub}</small>
              </div>
              {index < 4 && <b>→</b>}
            </article>
          ))}
        </section>

        <section className="sf177-workspace">
          <form className="sf177-upload-card" onSubmit={analyse}>
            <div className="sf177-card-title">
              <span className="sf177-title-icon">▣</span>
              <div>
                <h2>Upload a photo</h2>
                <p>Show the full item where possible. Labels and logos help with exact identification.</p>
              </div>
            </div>

            <label className={`sf177-dropzone ${preview ? "has-image" : ""}`}>
              {preview ? (
                <img src={preview} alt="Selected item" />
              ) : (
                <div className="sf177-drop-inner">
                  <span className="sf177-upload-icon">▣</span>
                  <strong>Drop, browse or take a photo</strong>
                  <small>JPG, PNG or WebP · Up to 10 MB</small>
                </div>
              )}
              <input
                type="file"
                accept="image/jpeg,image/png,image/webp"
                capture="environment"
                onChange={chooseFile}
              />
            </label>

            <div className="sf177-or">or</div>

            <div className="sf177-file-buttons">
              <label className="secondary">
                ▣ Take a photo
                <input type="file" accept="image/*" capture="environment" onChange={chooseFile} />
              </label>
              <label className="primary">
                ⇧ Choose a file
                <input type="file" accept="image/jpeg,image/png,image/webp" onChange={chooseFile} />
              </label>
            </div>

            <label className="sf177-hint">
              <span>◇</span>
              <input
                name="hint"
                placeholder="Anything you already know? (Optional)  e.g. A4Tech keyboard, office chair..."
              />
            </label>

            <div className="sf177-tips">
              <span>✓ Show the full item</span>
              <span>✓ Include logos or labels</span>
              <span>✓ Good lighting</span>
            </div>

            <button className="sf177-analyse-button" disabled={!file || loading}>
              ✦ {loading ? "Analysing item..." : "Analyse item"}
            </button>

            {error && <div className="sf177-error">{error}</div>}
          </form>

          <section className="sf177-report">
            {!result ? (
              <>
                <div className="sf177-report-title">Your visual intelligence report</div>

                <div className="sf177-report-empty">
                  <div className="sf177-report-art">
                    <div className="sf177-art-back one"></div>
                    <div className="sf177-art-back two"></div>
                    <div className="sf177-art-main">🔎</div>
                    <div className="sf177-art-chip left">▣</div>
                    <div className="sf177-art-chip right">◇</div>
                    <div className="sf177-art-chip bottom">▥</div>
                  </div>

                  <h2>Upload a photo to see your results</h2>
                  <p>
                    SiteFace will identify the item, verify the result, assess its visible condition
                    and show indicative market value with similar items.
                  </p>

                  <div className="sf177-report-cards">
                    <article className="blue">
                      <span>🔎</span><strong>Identified item</strong><p>Brand, model and category</p>
                    </article>
                    <article className="green">
                      <span>🛡</span><strong>Verification</strong><p>Cross-checks and confidence</p>
                    </article>
                    <article className="amber">
                      <span>⚙</span><strong>Condition</strong><p>Visible wear and quality</p>
                    </article>
                    <article className="violet">
                      <span>£</span><strong>Market value</strong><p>Estimated range and comparables</p>
                    </article>
                  </div>
                </div>
              </>
            ) : (
              <div className="sf177-results">
                <div className="sf177-report-title">Your visual intelligence report</div>

                <article className="sf177-result-card identify">
                  <div className="sf177-result-head">
                    <div>
                      <span className="sf177-result-label">IDENTIFIED ITEM</span>
                      <h2>{result.identification?.item_name || "Item identified"}</h2>
                      <p>
                        {[result.identification?.brand, result.identification?.model, result.identification?.variant]
                          .filter(Boolean)
                          .join(" · ") || "Brand/model not confirmed"}
                      </p>
                    </div>
                    <div className="sf177-result-score">{pct(result.identification?.confidence)}</div>
                  </div>

                  <div className={`sf177-verify ${result.verification?.verified ? "ok" : "warn"}`}>
                    <strong>{result.verification?.verified ? "✓ Identity verified" : "Identity needs review"}</strong>
                    <p>{result.verification?.reason}</p>
                  </div>

                  {!!result.identification?.identifying_features?.length && (
                    <div className="sf177-tags">
                      {result.identification.identifying_features.slice(0, 5).map((x) => (
                        <span key={x}>{x}</span>
                      ))}
                    </div>
                  )}
                </article>

                <article className="sf177-result-card condition">
                  <div className="sf177-result-head">
                    <div>
                      <span className="sf177-result-label green">CONDITION</span>
                      <h2>{result.condition?.grade || "UNKNOWN"}</h2>
                      <p>{result.condition?.summary}</p>
                    </div>
                    <div className="sf177-result-score green">{pct(result.condition?.confidence)}</div>
                  </div>

                  <div className="sf177-condition-grid">
                    <div>
                      <strong>Visible wear</strong>
                      {(result.condition?.visible_wear?.length ? result.condition.visible_wear : ["None confidently identified"])
                        .slice(0, 3)
                        .map((x) => <span key={x}>{x}</span>)}
                    </div>
                    <div>
                      <strong>Visible damage</strong>
                      {(result.condition?.visible_damage?.length ? result.condition.visible_damage : ["None confidently identified"])
                        .slice(0, 3)
                        .map((x) => <span key={x}>{x}</span>)}
                    </div>
                    <div className="limited">
                      <strong>Cannot confirm</strong>
                      {(result.condition?.limitations?.length ? result.condition.limitations : ["No additional limitations returned"])
                        .slice(0, 3)
                        .map((x) => <span key={x}>{x}</span>)}
                    </div>
                  </div>
                </article>

                <div className="sf177-result-grid">
                  <article className="sf177-result-card value">
                    <span className="sf177-result-label violet">MARKET VALUE</span>
                    {result.market?.available ? (
                      <>
                        <h2>
                          {money(result.market.low, result.market.currency)} – {money(result.market.high, result.market.currency)}
                        </h2>
                        <p>{result.market.evidence_summary}</p>
                        <div className="sf177-price-pair">
                          <div><span>Suggested</span><strong>{money(result.market.suggested, result.market.currency)}</strong></div>
                          <div><span>Quick sale</span><strong>{money(result.market.quick_sale, result.market.currency)}</strong></div>
                        </div>
                      </>
                    ) : (
                      <>
                        <h2>More detail needed</h2>
                        <p>{result.market?.reason || "SiteFace needs more verified evidence before showing a value."}</p>
                      </>
                    )}
                  </article>

                  <article className="sf177-result-card discover">
                    <span className="sf177-result-label violet">DISCOVER</span>
                    <div className="sf177-market-links">
                      {links.map((link) => (
                        <a key={link.label} href={link.href} target="_blank" rel="noreferrer">
                          <span>{link.mark}</span>
                          <div><strong>{link.label}</strong><small>Search marketplace ↗</small></div>
                        </a>
                      ))}
                    </div>
                  </article>
                </div>
              </div>
            )}
          </section>
        </section>
      </main>
    </div>
  );
}
