"use client";

import { usePathname } from "next/navigation";

export default function SiteFaceNavigation() {
  const pathname = usePathname();

  const links = [
    { href: "/", label: "Home", icon: "⌂" },
    { href: "/analyse", label: "Analyse", icon: "◎" },
    { href: "/history", label: "History", icon: "◷" },
  ];

  return (
    <aside className="sf171-nav">
      <a href="/" className="sf171-brand">
        <div className="sf171-logo">SF</div>
        <div><strong>SiteFace</strong><span>Visual Intelligence</span></div>
      </a>

      <a href="/analyse" className="sf171-new">＋ Analyse item</a>

      <nav>
        {links.map((link) => {
          const active = link.href === "/" ? pathname === "/" : pathname.startsWith(link.href);
          return (
            <a key={link.href} href={link.href} className={active ? "active" : ""}>
              <span>{link.icon}</span>
              <strong>{link.label}</strong>
            </a>
          );
        })}
      </nav>

      <div className="sf171-nav-note">
        <span>VISUAL INTELLIGENCE</span>
        <strong>See it. Know it. Value it.</strong>
        <p>Understand the things you own and discover.</p>
      </div>
    </aside>
  );
}
