"use client";

import { ChangeEvent, FormEvent, useEffect, useMemo, useState } from "react";

type Result = {
  identification?: { item_name?: string; brand?: string | null; model?: string | null; variant?: string | null; confidence?: number; identifying_features?: string[]; };
  verification?: { verified?: boolean; reason?: string; };
  condition?: { grade?: string; confidence?: number; summary?: string; visible_wear?: string[]; visible_damage?: string[]; limitations?: string[]; };
  valuation_context?: { search_query?: string; };
  market?: { available?: boolean; reason?: string | null; currency?: string; low?: number | null; high?: number | null; suggested?: number | null; quick_sale?: number | null; confidence?: number; evidence_summary?: string | null; search_query?: string; };
};

const pct = (v?: number) => typeof v === "number" ? `${Math.round(v * 100)}%` : "—";
function money(v?: number | null, currency = "GBP") {
  if (typeof v !== "number") return "—";
  return new Intl.NumberFormat("en-GB", { style: "currency", currency, maximumFractionDigits: 0 }).format(v);
}

export default function AnalyseItemClient() {
  const [file, setFile] = useState<File | null>(null);
  const [preview, setPreview] = useState<string | null>(null);
  const [result, setResult] = useState<Result | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => () => { if (preview) URL.revokeObjectURL(preview); }, [preview]);

  const searchQuery = result?.market?.search_query || result?.valuation_context?.search_query || result?.identification?.item_name || "used item";
  const links = useMemo(() => {
    const q = encodeURIComponent(searchQuery);
    return [
      ["eBay UK", `https://www.ebay.co.uk/sch/i.html?_nkw=${q}`, "e"],
      ["Google Shopping", `https://www.google.com/search?tbm=shop&q=${q}`, "G"],
      ["Gumtree", `https://www.gumtree.com/search?search_category=all&q=${q}`, "g"],
    ];
  }, [searchQuery]);

  function chooseFile(e: ChangeEvent<HTMLInputElement>) {
    const next = e.target.files?.[0] ?? null;
    if (preview) URL.revokeObjectURL(preview);
    setFile(next); setPreview(next ? URL.createObjectURL(next) : null); setResult(null); setError("");
  }

  async function analyse(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    if (!file) return setError("Choose a photo first.");
    setLoading(true); setError(""); setResult(null);
    const form = new FormData(e.currentTarget); form.set("image", file);
    try {
      const response = await fetch("/api/analyse-item", { method: "POST", body: form });
      const payload = await response.json();
      if (!response.ok) throw new Error(payload.error || "Analysis failed.");
      setResult(payload);
    } catch (e) { setError(e instanceof Error ? e.message : "Analysis failed."); }
    finally { setLoading(false); }
  }

  return (
    <main className="sf176-page">
      <section className="sf176-hero">
        <div>
          <span className="sf176-kicker">VISUAL INTELLIGENCE</span>
          <h1>See it. <span>Know it.</span> Value it.</h1>
          <p>Upload one photo and SiteFace turns it into a verified item report with condition and market insight.</p>
        </div>
        <div className="sf176-product-strip" aria-hidden="true"><div>⌚</div><div>🪑</div><div>👟</div><div>👜</div><div>🎧</div><div>💻</div></div>
      </section>

      <section className="sf176-flow">
        {[["🔎","Identify","What is it?"],["🛡","Verify","Can we trust it?"],["⚙","Condition","What's the state?"],["£","Value","What's it worth?"],["◫","Discover","Find similar"]].map(([icon,title,sub],i)=>(
          <article key={title}><b>{icon}</b><div><strong>{title}</strong><span>{sub}</span></div>{i<4&&<i>→</i>}</article>
        ))}
      </section>

      <section className="sf176-workspace">
        <form className="sf176-upload-card" onSubmit={analyse}>
          <div className="sf176-upload-heading"><span>▣</span><div><h2>Upload a photo</h2><p>Show the full item where possible. Labels and logos help with exact identification.</p></div></div>
          <label className="sf176-dropzone">
            {preview ? <img src={preview} alt="Selected item"/> : <div><span className="sf176-upload-icon">▣</span><strong>Drop, browse or take a photo</strong><small>JPG, PNG or WebP · Up to 10 MB</small></div>}
            <input type="file" accept="image/jpeg,image/png,image/webp" capture="environment" onChange={chooseFile}/>
          </label>
          <div className="sf176-or">or</div>
          <div className="sf176-file-actions">
            <label>▣ Take a photo<input type="file" accept="image/*" capture="environment" onChange={chooseFile}/></label>
            <label className="primary">⇧ Choose a file<input type="file" accept="image/jpeg,image/png,image/webp" onChange={chooseFile}/></label>
          </div>
          <label className="sf176-hint"><span>◇</span><input name="hint" placeholder="Anything you already know? (Optional)   e.g. A4Tech keyboard, office chair, Samsung TV..."/></label>
          <div className="sf176-tips"><span>✓ Show the full item</span><span>✓ Include logos or labels</span><span>✓ Good lighting</span></div>
          <button className="sf176-analyse-button" disabled={!file || loading}>✦ {loading ? "Analysing item..." : "Analyse item"}</button>
          {error && <div className="sf176-error">{error}</div>}
        </form>

        <section className="sf176-report">
          <div className="sf176-report-title">Your visual intelligence report</div>
          {!result ? (
            <div className="sf176-report-empty">
              <div className="sf176-report-art"><span>🔎</span></div>
              <h2>Upload a photo to see your results</h2>
              <p>SiteFace will identify the item, verify the result, assess its visible condition and show indicative market value with similar items.</p>
              <div className="sf176-report-cards">
                <article><b>🔎</b><strong>Identified item</strong><span>Brand, model and category</span></article>
                <article><b>🛡</b><strong>Verification</strong><span>Cross-checks and confidence</span></article>
                <article><b>⚙</b><strong>Condition</strong><span>Visible wear and quality</span></article>
                <article><b>£</b><strong>Market value</strong><span>Estimated range and comparables</span></article>
              </div>
            </div>
          ) : (
            <div className="sf176-results">
              <article className="sf176-result-card identify"><div><small>IDENTIFIED ITEM</small><h2>{result.identification?.item_name || "Item identified"}</h2><p>{[result.identification?.brand,result.identification?.model,result.identification?.variant].filter(Boolean).join(" · ") || "Brand/model not confirmed"}</p></div><strong>{pct(result.identification?.confidence)}</strong></article>
              <article className="sf176-result-card verify"><h3>{result.verification?.verified ? "✓ Identity verified" : "Identity needs review"}</h3><p>{result.verification?.reason}</p></article>
              <article className="sf176-result-card condition"><div><small>CONDITION</small><h2>{result.condition?.grade || "UNKNOWN"}</h2><p>{result.condition?.summary}</p></div><strong>{pct(result.condition?.confidence)}</strong></article>
              <div className="sf176-result-grid">
                <article className="sf176-result-card value"><small>MARKET VALUE</small><h2>{result.market?.available ? `${money(result.market.low,result.market.currency)} – ${money(result.market.high,result.market.currency)}` : "More detail needed"}</h2><p>{result.market?.available ? result.market.evidence_summary : result.market?.reason}</p></article>
                <article className="sf176-result-card discover"><small>DISCOVER</small><div className="sf176-market-links">{links.map(([label,href,mark])=><a key={label} href={href} target="_blank" rel="noreferrer"><span>{mark}</span>{label}</a>)}</div></article>
              </div>
            </div>
          )}
        </section>
      </section>
    </main>
  );
}
