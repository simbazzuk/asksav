"use client";

import { usePathname } from "next/navigation";

export default function SiteFaceNavigation() {
  const pathname = usePathname();

  return (
    <header className="sf175-nav">
      <div className="sf175-nav-inner">
        <a href="/" className="sf175-brand">
          <span className="sf175-brand-mark">SF</span>
          <span>
            <strong>SiteFace</strong>
            <small>Visual Intelligence</small>
          </span>
        </a>

        <nav className="sf175-nav-links" aria-label="Primary navigation">
          <a href="/" className={pathname === "/" ? "active" : ""}>Home</a>
          <a href="/analyse" className={pathname.startsWith("/analyse") ? "active" : ""}>Analyse</a>
          <a href="/history" className={pathname.startsWith("/history") ? "active" : ""}>History</a>
        </nav>

        <a href="/analyse" className="sf175-nav-action">Analyse an item</a>
      </div>
    </header>
  );
}
