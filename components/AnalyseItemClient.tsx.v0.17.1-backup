"use client";

import { ChangeEvent, FormEvent, useEffect, useMemo, useState } from "react";

type Result = {
  classification?: { object_class?: string; confidence?: number; hint_consistency?: string; hint_note?: string | null; };
  identification?: { category?: string; item_name?: string; brand?: string | null; model?: string | null; variant?: string | null; confidence?: number; identifying_features?: string[]; };
  verification?: { verified?: boolean; verification_confidence?: number; status?: string; reason?: string; };
  condition?: { grade?: string; confidence?: number; summary?: string; visible_wear?: string[]; visible_damage?: string[]; limitations?: string[]; };
  valuation_context?: { search_query?: string; attributes_to_confirm?: string[]; };
  market?: { available?: boolean; reason?: string | null; currency?: string; low?: number | null; high?: number | null; suggested?: number | null; quick_sale?: number | null; confidence?: number; evidence_summary?: string | null; search_query?: string; };
};

function pct(value?: number) {
  if (typeof value !== "number") return "—";
  return `${Math.round(value * 100)}%`;
}

function money(value?: number | null, currency = "GBP") {
  if (typeof value !== "number") return "—";
  try {
    return new Intl.NumberFormat("en-GB", { style: "currency", currency, maximumFractionDigits: 0 }).format(value);
  } catch {
    return `£${Math.round(value)}`;
  }
}

function marketplaceLinks(query: string) {
  const q = encodeURIComponent(query);
  return [
    { label: "eBay UK", href: `https://www.ebay.co.uk/sch/i.html?_nkw=${q}`, mark: "e" },
    { label: "Google Shopping", href: `https://www.google.com/search?tbm=shop&q=${q}`, mark: "G" },
    { label: "Gumtree", href: `https://www.gumtree.com/search?search_category=all&q=${q}`, mark: "g" },
  ];
}

export default function AnalyseItemClient() {
  const [file, setFile] = useState<File | null>(null);
  const [preview, setPreview] = useState<string | null>(null);
  const [result, setResult] = useState<Result | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => () => { if (preview) URL.revokeObjectURL(preview); }, [preview]);

  const searchQuery =
    result?.market?.search_query ||
    result?.valuation_context?.search_query ||
    result?.identification?.item_name ||
    "used item";

  const links = useMemo(() => marketplaceLinks(searchQuery), [searchQuery]);

  function chooseFile(e: ChangeEvent<HTMLInputElement>) {
    const next = e.target.files?.[0] ?? null;
    if (preview) URL.revokeObjectURL(preview);
    setFile(next);
    setPreview(next ? URL.createObjectURL(next) : null);
    setResult(null);
    setError("");
  }

  async function analyse(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    if (!file) {
      setError("Choose a photo first.");
      return;
    }

    setLoading(true);
    setError("");
    setResult(null);

    const form = new FormData(e.currentTarget);
    form.set("image", file);

    try {
      const response = await fetch("/api/analyse-item", { method: "POST", body: form });
      const payload = await response.json();
      if (!response.ok) throw new Error(payload.error || "Analysis failed.");
      setResult(payload);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Analysis failed.");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="sf17-analyse">
      <section className="sf17-analyse-head">
        <div>
          <div className="sf17-eyebrow">VISUAL INTELLIGENCE</div>
          <h1>Analyse an <span>item</span></h1>
          <p>One photo gives you identity, verification, visible condition and market insight.</p>
        </div>

        <div className="sf17-analyse-flow">
          {[
            ["1", "Identify"],
            ["2", "Verify"],
            ["3", "Condition"],
            ["4", "Value"],
            ["5", "Discover"],
          ].map(([n, label]) => (
            <div key={n}><span>{n}</span><strong>{label}</strong></div>
          ))}
        </div>
      </section>

      <div className="sf17-analyse-grid">
        <form className="sf17-upload" onSubmit={analyse}>
          <div className="sf17-upload-title">
            <span>1</span>
            <div>
              <small>UPLOAD IMAGE</small>
              <h2>Show us the item</h2>
            </div>
          </div>

          <label className={`sf17-upload-zone ${preview ? "has-image" : ""}`}>
            {preview ? (
              <img src={preview} alt="Selected item" />
            ) : (
              <div className="sf17-upload-empty">
                <div className="sf17-upload-icon">＋</div>
                <strong>Take or upload a photo</strong>
                <span>Use a clear image showing the full item where possible.</span>
              </div>
            )}
            <input type="file" accept="image/jpeg,image/png,image/webp" capture="environment" onChange={chooseFile} />
          </label>

          {preview && (
            <label className="sf17-replace">
              Replace image
              <input type="file" accept="image/jpeg,image/png,image/webp" capture="environment" onChange={chooseFile} />
            </label>
          )}

          <label className="sf17-input-label">
            <span>Anything you already know? <small>Optional</small></span>
            <input name="hint" placeholder="e.g. A4Tech keyboard, office chair..." />
          </label>

          <div className="sf17-tipbox">
            <strong>For a better result</strong>
            <span>✓ Include logos, labels or model markings.</span>
            <span>✓ Show the complete item where practical.</span>
            <span>✓ Your hint supports the image; it never overrides it.</span>
          </div>

          <button className="sf17-analyse-button" disabled={!file || loading}>
            {loading ? "Analysing your item..." : "Analyse item"}
          </button>

          {error && <div className="sf17-error">{error}</div>}
        </form>

        <section className="sf17-results">
          {!result ? (
            <div className="sf17-empty-result">
              <div className="sf17-empty-orb">◎</div>
              <h2>Your visual intelligence report</h2>
              <p>Upload a photo to see what the item is, whether the identity can be verified, its visible condition and indicative market value.</p>
              <div className="sf17-empty-chips">
                <span>Identify</span><span>Verify</span><span>Condition</span><span>Value</span>
              </div>
            </div>
          ) : (
            <>
              <article className="sf17-result sf17-result-identify">
                <div className="sf17-result-top">
                  <div className="sf17-result-number">2</div>
                  <div className="sf17-result-title">
                    <small>IDENTIFIED ITEM</small>
                    <h2>{result.identification?.item_name || "Item identified"}</h2>
                    <p>{[result.identification?.brand, result.identification?.model, result.identification?.variant].filter(Boolean).join(" · ") || "Brand/model not confirmed"}</p>
                  </div>
                  <div className="sf17-confidence">
                    <strong>{pct(result.identification?.confidence)}</strong>
                    <span>confidence</span>
                  </div>
                </div>

                <div className="sf17-verify-band">
                  <span className={result.verification?.verified ? "ok" : "warn"}>
                    {result.verification?.verified ? "✓ Identity verified" : "Identity not verified"}
                  </span>
                  <p>{result.verification?.reason}</p>
                </div>

                {!!result.identification?.identifying_features?.length && (
                  <div className="sf17-tags">
                    {result.identification.identifying_features.map((x) => <span key={x}>{x}</span>)}
                  </div>
                )}
              </article>

              <article className="sf17-result sf17-result-condition">
                <div className="sf17-result-top">
                  <div className="sf17-result-number green">3</div>
                  <div className="sf17-result-title">
                    <small>VISIBLE CONDITION</small>
                    <h2>{result.condition?.grade || "UNKNOWN"}</h2>
                    <p>{result.condition?.summary}</p>
                  </div>
                  <div className="sf17-confidence green">
                    <strong>{pct(result.condition?.confidence)}</strong>
                    <span>confidence</span>
                  </div>
                </div>

                <div className="sf17-condition-cards">
                  <div>
                    <strong>Visible wear</strong>
                    {(result.condition?.visible_wear?.length ? result.condition.visible_wear : ["None confidently identified"]).map((x) => <span key={x}>• {x}</span>)}
                  </div>
                  <div>
                    <strong>Visible damage</strong>
                    {(result.condition?.visible_damage?.length ? result.condition.visible_damage : ["None confidently identified"]).map((x) => <span key={x}>• {x}</span>)}
                  </div>
                  <div className="uncertain">
                    <strong>What cannot be confirmed</strong>
                    {(result.condition?.limitations?.length ? result.condition.limitations : ["No additional limitations returned"]).map((x) => <span key={x}>• {x}</span>)}
                  </div>
                </div>
              </article>

              <div className="sf17-value-discover">
                <article className="sf17-result sf17-result-value">
                  <div className="sf17-result-number violet">4</div>
                  <small>ESTIMATED USED VALUE</small>
                  {result.market?.available ? (
                    <>
                      <h2>{money(result.market.low, result.market.currency)} – {money(result.market.high, result.market.currency)}</h2>
                      <div className="sf17-price-row">
                        <div><span>Suggested listing</span><strong>{money(result.market.suggested, result.market.currency)}</strong></div>
                        <div><span>Quick sale</span><strong>{money(result.market.quick_sale, result.market.currency)}</strong></div>
                      </div>
                      <p>{result.market.evidence_summary}</p>
                    </>
                  ) : (
                    <>
                      <h2>More detail needed</h2>
                      <p>{result.market?.reason || "SiteFace will only value a verified item."}</p>
                    </>
                  )}
                </article>

                <article className="sf17-result sf17-result-discover">
                  <div className="sf17-discover-head">
                    <div>
                      <div className="sf17-result-number violet">5</div>
                      <small>SIMILAR ITEMS</small>
                    </div>
                    <span>Explore market</span>
                  </div>

                  <div className="sf17-market-grid">
                    {links.map((link) => (
                      <a key={link.label} href={link.href} target="_blank" rel="noreferrer">
                        <div className="sf17-market-thumb">
                          {preview ? <img src={preview} alt="" /> : <b>{link.mark}</b>}
                        </div>
                        <strong>{link.label}</strong>
                        <span>View similar items ↗</span>
                      </a>
                    ))}
                  </div>
                </article>
              </div>

              <div className="sf17-complete">
                <span>✓</span>
                <div>
                  <strong>Analysis complete</strong>
                  <p>You can now explore similar items or analyse something else.</p>
                </div>
                <button type="button" onClick={() => { setFile(null); setPreview(null); setResult(null); }}>
                  Analyse another item
                </button>
              </div>
            </>
          )}
        </section>
      </div>
    </main>
  );
}
