"use client";

import { ChangeEvent, FormEvent, useEffect, useMemo, useState } from "react";

type Result = {
  classification?: { object_class?: string; confidence?: number; hint_consistency?: string; hint_note?: string | null; };
  identification?: { category?: string; item_name?: string; brand?: string | null; model?: string | null; variant?: string | null; confidence?: number; identifying_features?: string[]; };
  verification?: { verified?: boolean; verification_confidence?: number; status?: string; reason?: string; };
  condition?: { grade?: string; confidence?: number; summary?: string; visible_wear?: string[]; visible_damage?: string[]; limitations?: string[]; };
  valuation_context?: { search_query?: string; attributes_to_confirm?: string[]; };
  market?: { available?: boolean; reason?: string | null; currency?: string; low?: number | null; high?: number | null; suggested?: number | null; quick_sale?: number | null; confidence?: number; evidence_summary?: string | null; search_query?: string; };
};

function pct(value?: number) {
  if (typeof value !== "number") return "—";
  return `${Math.round(value * 100)}%`;
}

function money(value?: number | null, currency = "GBP") {
  if (typeof value !== "number") return "—";
  try {
    return new Intl.NumberFormat("en-GB", { style: "currency", currency, maximumFractionDigits: 0 }).format(value);
  } catch {
    return `£${Math.round(value)}`;
  }
}

function marketplaceLinks(query: string) {
  const q = encodeURIComponent(query);
  return [
    { label: "eBay UK", href: `https://www.ebay.co.uk/sch/i.html?_nkw=${q}`, mark: "e" },
    { label: "Google", href: `https://www.google.com/search?tbm=shop&q=${q}`, mark: "G" },
    { label: "Gumtree", href: `https://www.gumtree.com/search?search_category=all&q=${q}`, mark: "g" },
  ];
}

export default function AnalyseItemClient() {
  const [file, setFile] = useState<File | null>(null);
  const [preview, setPreview] = useState<string | null>(null);
  const [result, setResult] = useState<Result | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => () => { if (preview) URL.revokeObjectURL(preview); }, [preview]);

  const searchQuery =
    result?.market?.search_query ||
    result?.valuation_context?.search_query ||
    result?.identification?.item_name ||
    "used item";

  const links = useMemo(() => marketplaceLinks(searchQuery), [searchQuery]);

  function chooseFile(e: ChangeEvent<HTMLInputElement>) {
    const next = e.target.files?.[0] ?? null;
    if (preview) URL.revokeObjectURL(preview);
    setFile(next);
    setPreview(next ? URL.createObjectURL(next) : null);
    setResult(null);
    setError("");
  }

  async function analyse(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    if (!file) {
      setError("Choose a photo first.");
      return;
    }

    setLoading(true);
    setError("");
    setResult(null);

    const form = new FormData(e.currentTarget);
    form.set("image", file);

    try {
      const response = await fetch("/api/analyse-item", { method: "POST", body: form });
      const payload = await response.json();
      if (!response.ok) throw new Error(payload.error || "Analysis failed.");
      setResult(payload);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Analysis failed.");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="sf171-page">
      <section className="sf171-hero">
        <div className="sf171-hero-copy">
          <span className="sf171-kicker">VISUAL INTELLIGENCE</span>
          <h1>Snap it. <span>Know it.</span> Value it.</h1>
          <p>Upload one photo and SiteFace turns it into a verified item report with condition and market insight.</p>
        </div>

        <div className="sf171-journey">
          {[
            ["01", "Identify"],
            ["02", "Verify"],
            ["03", "Condition"],
            ["04", "Value"],
            ["05", "Discover"],
          ].map(([n, label]) => (
            <div key={n}>
              <span>{n}</span>
              <strong>{label}</strong>
            </div>
          ))}
        </div>
      </section>

      <div className="sf171-grid">
        <form className="sf171-capture" onSubmit={analyse}>
          <div className="sf171-section-label">YOUR ITEM</div>
          <h2>Upload a photo</h2>
          <p className="sf171-subcopy">A clear, full view gives SiteFace the best chance of identifying the item correctly.</p>

          <label className={`sf171-photo ${preview ? "has-image" : ""}`}>
            {preview ? (
              <img src={preview} alt="Selected item" />
            ) : (
              <div className="sf171-photo-empty">
                <div className="sf171-camera">◎</div>
                <strong>Drop, browse or take a photo</strong>
                <span>JPG, PNG or WebP</span>
              </div>
            )}
            <input type="file" accept="image/jpeg,image/png,image/webp" capture="environment" onChange={chooseFile} />
          </label>

          {preview && (
            <label className="sf171-replace">
              Change photo
              <input type="file" accept="image/jpeg,image/png,image/webp" capture="environment" onChange={chooseFile} />
            </label>
          )}

          <label className="sf171-hint">
            <span>What do you already know? <small>Optional</small></span>
            <input name="hint" placeholder="Brand, product type or model..." />
          </label>

          <div className="sf171-tips">
            <span>✓ Include labels or logos</span>
            <span>✓ Show the full item</span>
            <span>✓ Avoid blur and glare</span>
          </div>

          <button className="sf171-button" disabled={!file || loading}>
            {loading ? "Analysing item..." : "Analyse item"}
          </button>

          {error && <div className="sf171-error">{error}</div>}
        </form>

        <section className="sf171-report">
          {!result ? (
            <div className="sf171-placeholder">
              <div className="sf171-placeholder-art">
                <div className="sf171-shape one"></div>
                <div className="sf171-shape two"></div>
                <div className="sf171-lens">◎</div>
              </div>
              <span className="sf171-kicker">YOUR REPORT</span>
              <h2>See what your item can tell you.</h2>
              <p>SiteFace will identify it, verify the result, assess visible condition and help you understand its market value.</p>

              <div className="sf171-placeholder-grid">
                <div><b>01</b><strong>Identify</strong><span>What is it?</span></div>
                <div><b>02</b><strong>Verify</strong><span>Can we trust it?</span></div>
                <div><b>03</b><strong>Condition</strong><span>What can we see?</span></div>
                <div><b>04</b><strong>Value</strong><span>What's it worth?</span></div>
              </div>
            </div>
          ) : (
            <div className="sf171-report-stack">
              <article className="sf171-card sf171-identity">
                <div className="sf171-card-row">
                  <div>
                    <div className="sf171-chip blue">IDENTIFIED ITEM</div>
                    <h2>{result.identification?.item_name || "Item identified"}</h2>
                    <p>{[result.identification?.brand, result.identification?.model, result.identification?.variant].filter(Boolean).join(" · ") || "Brand/model not confirmed"}</p>
                  </div>
                  <div className="sf171-score blue">
                    <strong>{pct(result.identification?.confidence)}</strong>
                    <span>confidence</span>
                  </div>
                </div>

                <div className={`sf171-verification ${result.verification?.verified ? "ok" : "warn"}`}>
                  <strong>{result.verification?.verified ? "✓ Identity verified" : "Identity needs review"}</strong>
                  <span>{result.verification?.reason}</span>
                </div>

                {!!result.identification?.identifying_features?.length && (
                  <div className="sf171-tags">
                    {result.identification.identifying_features.slice(0, 5).map((x) => <span key={x}>{x}</span>)}
                  </div>
                )}
              </article>

              <article className="sf171-card sf171-condition">
                <div className="sf171-card-row">
                  <div>
                    <div className="sf171-chip green">VISIBLE CONDITION</div>
                    <h2>{result.condition?.grade || "UNKNOWN"}</h2>
                    <p>{result.condition?.summary}</p>
                  </div>
                  <div className="sf171-score green">
                    <strong>{pct(result.condition?.confidence)}</strong>
                    <span>confidence</span>
                  </div>
                </div>

                <div className="sf171-condition-grid">
                  <div>
                    <strong>Visible wear</strong>
                    {(result.condition?.visible_wear?.length ? result.condition.visible_wear : ["None confidently identified"]).slice(0, 3).map((x) => <span key={x}>{x}</span>)}
                  </div>
                  <div>
                    <strong>Visible damage</strong>
                    {(result.condition?.visible_damage?.length ? result.condition.visible_damage : ["None confidently identified"]).slice(0, 3).map((x) => <span key={x}>{x}</span>)}
                  </div>
                  <div className="limited">
                    <strong>Cannot confirm</strong>
                    {(result.condition?.limitations?.length ? result.condition.limitations : ["No additional limitations returned"]).slice(0, 3).map((x) => <span key={x}>{x}</span>)}
                  </div>
                </div>
              </article>

              <div className="sf171-lower">
                <article className="sf171-card sf171-value">
                  <div className="sf171-chip violet">MARKET VALUE</div>
                  {result.market?.available ? (
                    <>
                      <h2>{money(result.market.low, result.market.currency)} – {money(result.market.high, result.market.currency)}</h2>
                      <p>{result.market.evidence_summary}</p>
                      <div className="sf171-price-stats">
                        <div><span>List around</span><strong>{money(result.market.suggested, result.market.currency)}</strong></div>
                        <div><span>Quick sale</span><strong>{money(result.market.quick_sale, result.market.currency)}</strong></div>
                      </div>
                    </>
                  ) : (
                    <>
                      <h2>More detail needed</h2>
                      <p>{result.market?.reason || "SiteFace needs more verified evidence before showing a value."}</p>
                    </>
                  )}
                </article>

                <article className="sf171-card sf171-discover">
                  <div className="sf171-chip violet">DISCOVER</div>
                  <h3>Find similar items</h3>
                  <div className="sf171-marketplaces">
                    {links.map((link) => (
                      <a key={link.label} href={link.href} target="_blank" rel="noreferrer">
                        <span className="sf171-market-logo">{link.mark}</span>
                        <div><strong>{link.label}</strong><small>Search marketplace ↗</small></div>
                      </a>
                    ))}
                  </div>
                </article>
              </div>
            </div>
          )}
        </section>
      </div>
    </main>
  );
}
