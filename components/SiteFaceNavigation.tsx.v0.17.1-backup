"use client";

import { usePathname } from "next/navigation";

const items = [
  { href: "/", label: "Home", icon: "⌂" },
  { href: "/analyse", label: "Analyse", icon: "◎" },
  { href: "/history", label: "History", icon: "◷" },
];

export default function SiteFaceNavigation() {
  const pathname = usePathname();

  return (
    <aside className="sf17-nav">
      <a className="sf17-brand" href="/">
        <span className="sf17-brand-mark">SF</span>
        <div><strong>SiteFace</strong><small>Visual Intelligence</small></div>
      </a>

      <a className="sf17-nav-cta" href="/analyse">＋ Analyse item</a>

      <nav>
        {items.map((item) => {
          const active = item.href === "/" ? pathname === "/" : pathname.startsWith(item.href);
          return (
            <a key={item.href} href={item.href} className={active ? "active" : ""}>
              <span>{item.icon}</span>{item.label}
            </a>
          );
        })}
      </nav>

      <div className="sf17-nav-footer">
        <strong>See it. Know it. Value it.</strong>
        <p>Visual intelligence for the things you own and discover.</p>
      </div>
    </aside>
  );
}
