"use client";

import { ChangeEvent, FormEvent, useEffect, useState } from "react";

type Result = {
  identification?: {
    category?: string;
    item_name?: string;
    brand?: string | null;
    model?: string | null;
    variant?: string | null;
    confidence?: number;
    identifying_features?: string[];
  };
  condition?: {
    grade?: string;
    confidence?: number;
    summary?: string;
    visible_wear?: string[];
    visible_damage?: string[];
    limitations?: string[];
  };
  valuation_context?: {
    search_query?: string;
    attributes_to_confirm?: string[];
  };
};

function pct(value?: number) {
  if (typeof value !== "number") return "—";
  return `${Math.round(value * 100)}%`;
}

export default function AnalyseItemClient() {
  const [file, setFile] = useState<File | null>(null);
  const [preview, setPreview] = useState<string | null>(null);
  const [result, setResult] = useState<Result | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    return () => {
      if (preview) URL.revokeObjectURL(preview);
    };
  }, [preview]);

  function chooseFile(e: ChangeEvent<HTMLInputElement>) {
    const next = e.target.files?.[0] ?? null;
    if (preview) URL.revokeObjectURL(preview);
    setFile(next);
    setPreview(next ? URL.createObjectURL(next) : null);
    setResult(null);
    setError("");
  }

  async function analyse(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    if (!file) {
      setError("Choose a photo first.");
      return;
    }

    setLoading(true);
    setError("");
    setResult(null);

    const form = new FormData(e.currentTarget);
    form.set("image", file);

    try {
      const response = await fetch("/api/analyse-item", {
        method: "POST",
        body: form,
      });

      const payload = await response.json();
      if (!response.ok) throw new Error(payload.error || "Analysis failed.");
      setResult(payload);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Analysis failed.");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="sf15-analyse">
      <section className="sf15-analyse-head">
        <div>
          <div className="sf15-kicker">VISUAL INTELLIGENCE</div>
          <h1>Analyse an item</h1>
          <p>Upload a clear photo. SiteFace will identify what it can see and assess visible condition.</p>
        </div>
        <div className="sf15-stage-pills">
          <span className="active">Identify</span>
          <span className="active">Condition</span>
          <span>Value · Preview</span>
          <span>Discover · Preview</span>
        </div>
      </section>

      <div className="sf15-analyse-grid">
        <form className="card card-pad sf15-upload-card" onSubmit={analyse}>
          <div className="sf15-upload-title">
            <div>
              <small>STEP 1</small>
              <h2>Show us the item</h2>
            </div>
          </div>

          <label className={`sf15-dropzone ${preview ? "has-image" : ""}`}>
            {preview ? (
              <img src={preview} alt="Item selected for analysis" />
            ) : (
              <div>
                <strong>Take or upload a photo</strong>
                <span>Use a clear image showing as much of the item as possible.</span>
              </div>
            )}
            <input type="file" accept="image/jpeg,image/png,image/webp" capture="environment" onChange={chooseFile} />
          </label>

          <label className="sf15-field">
            <span>Anything you already know? <small>Optional</small></span>
            <input name="hint" placeholder="e.g. Apple laptop, office chair, bicycle..." />
          </label>

          <div className="sf15-photo-tips">
            <strong>For a better result</strong>
            <span>Show the complete item where practical.</span>
            <span>Include logos, labels or model markings.</span>
            <span>Use additional details to resolve uncertain models.</span>
          </div>

          <button className="btn primary sf15-analyse-button" disabled={!file || loading}>
            {loading ? "Analysing..." : "Identify & assess condition"}
          </button>

          {error && <div className="sf15-error">{error}</div>}
        </form>

        <section className="sf15-results">
          {!result ? (
            <div className="card card-pad sf15-awaiting">
              <div className="sf15-awaiting-orb">AI</div>
              <h2>Your analysis will appear here</h2>
              <p>
                SiteFace separates identification from condition so uncertainty in
                one does not get hidden by the other.
              </p>
              <div className="sf15-awaiting-flow">
                <span>Identify</span><i>→</i><span>Condition</span><i>→</i><span>Value</span>
              </div>
            </div>
          ) : (
            <>
              <article className="sf15-result-card identify">
                <div className="sf15-result-label"><span>01</span> IDENTIFY</div>
                <div className="sf15-result-head">
                  <div>
                    <small>{result.identification?.category || "ITEM"}</small>
                    <h2>{result.identification?.item_name || "Item identified"}</h2>
                    <p>
                      {[result.identification?.brand, result.identification?.model, result.identification?.variant]
                        .filter(Boolean).join(" · ") || "No reliable brand/model confirmed from this image."}
                    </p>
                  </div>
                  <div className="sf15-score">
                    <strong>{pct(result.identification?.confidence)}</strong>
                    <small>confidence</small>
                  </div>
                </div>
                {!!result.identification?.identifying_features?.length && (
                  <div className="sf15-tags">
                    {result.identification.identifying_features.map((x) => <span key={x}>{x}</span>)}
                  </div>
                )}
              </article>

              <article className="sf15-result-card condition">
                <div className="sf15-result-label"><span>02</span> CONDITION</div>
                <div className="sf15-result-head">
                  <div>
                    <small>VISIBLE CONDITION</small>
                    <h2>{result.condition?.grade || "Unknown"}</h2>
                    <p>{result.condition?.summary || "No condition summary returned."}</p>
                  </div>
                  <div className="sf15-score">
                    <strong>{pct(result.condition?.confidence)}</strong>
                    <small>confidence</small>
                  </div>
                </div>

                <div className="sf15-condition-columns">
                  <div>
                    <strong>Visible wear</strong>
                    {(result.condition?.visible_wear?.length ? result.condition.visible_wear : ["None confidently identified"]).map((x) => <span key={x}>{x}</span>)}
                  </div>
                  <div>
                    <strong>Visible damage</strong>
                    {(result.condition?.visible_damage?.length ? result.condition.visible_damage : ["None confidently identified"]).map((x) => <span key={x}>{x}</span>)}
                  </div>
                </div>

                {!!result.condition?.limitations?.length && (
                  <div className="sf15-limitations">
                    <strong>What cannot be confirmed</strong>
                    {result.condition.limitations.map((x) => <span key={x}>{x}</span>)}
                  </div>
                )}
              </article>

              <article className="sf15-result-card value">
                <div className="sf15-result-label"><span>03</span> VALUE</div>
                <div className="sf15-value-preview">
                  <div>
                    <small>MARKET VALUATION</small>
                    <h2>Connect market evidence</h2>
                    <p>
                      SiteFace has created a comparable-search description from the
                      identification. Live prices are intentionally not invented.
                    </p>
                  </div>
                  <span className="sf15-preview-badge">PREVIEW</span>
                </div>
                <div className="sf15-search-query">
                  <small>SUGGESTED COMPARABLE SEARCH</small>
                  <strong>{result.valuation_context?.search_query || result.identification?.item_name || "Identified item"}</strong>
                </div>
                {!!result.valuation_context?.attributes_to_confirm?.length && (
                  <div className="sf15-confirm">
                    <small>Confirm these details for a stronger valuation</small>
                    <div className="sf15-tags">
                      {result.valuation_context.attributes_to_confirm.map((x) => <span key={x}>{x}</span>)}
                    </div>
                  </div>
                )}
              </article>
            </>
          )}
        </section>
      </div>
    </main>
  );
}
